<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PortScanner.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Display name -->
    <ApplicationTitle>ScanPort</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.scanport.app</ApplicationId>
    <AssemblyName>ScanPort</AssemblyName>

    <!-- Иконка exe (Windows) -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.4.4</ApplicationDisplayVersion>
    <ApplicationVersion>8</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Windows: обычный exe без упаковки MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Автономный APK: все сборки внутри, без fast deployment -->
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
    <AndroidUseFastDeployment Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidUseFastDeployment>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка приложения (Windows + Android) -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0b0f16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общий UI с веб-клиентом (src/PortScanner) -->
    <Content Include="..\PortScanner\wwwroot\css\app.css" Link="wwwroot\css\app.css" />
    <Content Include="..\PortScanner\wwwroot\favicon.ico" Link="wwwroot\favicon.ico" />
    <RazorComponent Include="..\PortScanner\App.razor" Link="App.razor" />
    <RazorComponent Include="..\PortScanner\_Imports.razor" Link="_Imports.razor" />
    <RazorComponent Include="..\PortScanner\Pages\Home.razor" Link="Pages\Home.razor" />
    <RazorComponent Include="..\PortScanner\Layout\MainLayout.razor" Link="Layout\MainLayout.razor" />
    <!-- Общий движок сканирования и ядро API с десктопным сервером (src/PortScanner.Server) -->
    <Compile Include="..\PortScanner.Server\ScanService.cs" Link="Core\ScanService.cs" />
    <Compile Include="..\PortScanner.Server\ScanApiCore.cs" Link="Core\ScanApiCore.cs" />
  </ItemGroup>

</Project>
