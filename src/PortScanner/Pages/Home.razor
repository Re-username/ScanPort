    private void SortBy(string column)
    {
        if (SortColumn == column) SortAscending = !SortAscending;
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
    }

    private string SortMark(string column) => SortColumn == column ? (SortAscending ? "▲" : "▼") : "";
    private string AriaSort(string column) => SortColumn != column ? "none" : (SortAscending ? "ascending" : "descending");

    private void AddLog(string text, string cssClass = "")
    {
        LogEntries.Insert(0, new LogEntry(DateTime.Now.ToString("HH:mm:ss"), text, cssClass));
        if (LogEntries.Count > MaxLogEntries)
            LogEntries.RemoveRange(MaxLogEntries, LogEntries.Count - MaxLogEntries);
    }

    private void ClearLog() => LogEntries.Clear();

    private async Task StartScan()
    {
        ErrorMessage = null;
        Results = new List<PortResult>();
        _knownKeys = new HashSet<string>();
        ScannedPorts = 0;
        TotalPorts = 0;
        ScanCompleted = false;
        IsPaused = false;
        _cancelRequested = false;
        PingInfo = null;
        _pingLogged = null;
        SortColumn = "port";
        SortAscending = true;

        if (string.IsNullOrWhiteSpace(Host))
        {
            ErrorMessage = "Введите IP-адрес или имя хоста.";
            return;
        }
        if (!TryParsePorts(PortsText, out var ports, out var portsError))
        {
            ErrorMessage = portsError;
            return;
        }
        if (TimeoutMs < 100 || TimeoutMs > 30000)
        {
            ErrorMessage = "Таймаут должен быть от 100 до 30000 мс.";
            return;
        }
        if (!DoTcp && !DoUdp)
        {
            ErrorMessage = "Выберите хотя бы один метод: TCP и/или UDP.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/scan/start", new
            {
                host = Host.Trim(),
                ports,
                timeoutMs = TimeoutMs,
                tcp = DoTcp,
                udp = DoUdp,
                banner = DoBanner,
                ping = DoPing,
                profile = NetMode
            });
            var body = await response.Content.ReadFromJsonAsync<ScanStartResponse>();
            if (body?.Error != null)
            {
                ErrorMessage = body.Error;
                AddLog(body.Error, "err");
                return;
            }
            response.EnsureSuccessStatusCode();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Не удалось запустить сканирование: " + ex.Message;
            AddLog(ErrorMessage, "err");
            return;
        }

        AddLog($"Сканирование запущено: {Host.Trim()} [{MethodsText()}], порты {PortsText.Trim()} (таймаут {TimeoutMs} мс)", "dim");
        IsScanning = true;
        _ = PollLoop();
    }

    private void SetNetMode(string mode)
    {
        NetMode = mode;
        TimeoutMs = mode switch
        {
            "wan" => 5000,
            "auto" => 2000, // базовый, пока AUTO не откалибруется по пингу
            _ => 1000,
        };
        SaveSettings();
    }

    private async Task SaveSettings()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new UiSettings
            {
                Host = Host,
                Ports = PortsText,
                TimeoutMs = TimeoutMs,
                Tcp = DoTcp,
                Udp = DoUdp,
                Banner = DoBanner,
                Ping = DoPing,
                NetMode = NetMode,
                OnlyOpen = OnlyOpen,
            });
            await JS.InvokeVoidAsync("localStorage.setItem", "portscan-settings", json);
        }
        catch { }
    }

    private async Task LoadSettings()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "portscan-settings");
            if (string.IsNullOrEmpty(json))
                return;
            var s = System.Text.Json.JsonSerializer.Deserialize<UiSettings>(json);
            if (s is null)
                return;
            if (!string.IsNullOrWhiteSpace(s.Host)) Host = s.Host;
            if (!string.IsNullOrWhiteSpace(s.Ports)) PortsText = s.Ports;
            if (s.TimeoutMs is >= 100 and <= 30000) TimeoutMs = s.TimeoutMs;
            DoTcp = s.Tcp;
            DoUdp = s.Udp;
            DoBanner = s.Banner;
            DoPing = s.Ping;
            if (s.NetMode is "lan" or "auto" or "wan") NetMode = s.NetMode;
            OnlyOpen = s.OnlyOpen;
        }
        catch { }
    }

    private sealed class UiSettings
    {
        public string? Host { get; set; }
        public string? Ports { get; set; }
        public int TimeoutMs { get; set; }
        public bool Tcp { get; set; } = true;
        public bool Udp { get; set; }
        public bool Banner { get; set; } = true;
        public bool Ping { get; set; } = true;
        public string NetMode { get; set; } = "lan";
        public bool OnlyOpen { get; set; } = true;
    }

    private void ToggleOnlyOpen(ChangeEventArgs e)
    {
        OnlyOpen = e.Value is bool b && b;
        SaveSettings();
        // сканирование не идёт, но на сервере лежат результаты последнего —
        // догружаем полный статус, чтобы закрытые появились/исчезли сразу
        if (!IsScanning)
            _ = RefreshResultsAsync();
    }

    private async Task RefreshResultsAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<ScanStatus>(OnlyOpen
                ? "api/scan/status"
                : "api/scan/status?all=1");
            if (status?.Results is not null)
            {
                Results = status.Results.ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    /// <summary>Парсит поле портов: "1-1024, 502, 8080, 9600". Дубликаты убираются, список сортируется.</summary>
    private static bool TryParsePorts(string text, out List<int> ports, out string? error)
    {
        ports = new List<int>();
        var seen = new HashSet<int>();
        foreach (var token in text.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var dash = token.IndexOf('-');
            try
            {
                if (dash >= 0)
                {
                    if (dash == 0 || dash == token.Length - 1)
                        throw new FormatException();
                    var a = int.Parse(token[..dash]);
                    var b = int.Parse(token[(dash + 1)..]);
                    if (a > b)
                        (a, b) = (b, a);
                    for (var p = a; p <= b; p++)
                        if (seen.Add(p))
                            ports.Add(p);
                }
                else
                {
                    var p = int.Parse(token);
                    if (seen.Add(p))
                        ports.Add(p);
                }
            }
            catch (FormatException)
            {
                error = $"Не понял фрагмент «{token}». Формат: 1-1024, 502, 8080";
                return false;
            }
            catch (OverflowException)
            {
                error = $"Слишком большое число в фрагменте «{token}». Порты — от 1 до 65535.";
                return false;
            }
        }

        if (ports.Count == 0)
        {
            error = "Укажите хотя бы один порт, например: 1-1024, 502";
            return false;
        }
        if (ports.Exists(p => p < 1 || p > 65535))
        {
            error = "Порты должны быть в диапазоне 1–65535.";
            return false;
        }
        if (ports.Count > 65535)
        {
            error = "Слишком много портов — максимум 65535 уникальных.";
            return false;
        }

        ports.Sort();
        error = null;
        return true;
    }

    private string MethodsText()    {
        var list = new List<string>();
        if (DoTcp) list.Add("TCP");
        if (DoUdp) list.Add("UDP");
        if (DoBanner) list.Add("баннер");
        if (DoPing) list.Add("ping/5с");
        return string.Join("+", list);
    }

    private async Task PollLoop()
    {
        while (IsScanning && !_disposed)
        {
            // большие списки (режим «все порты») опрашиваем реже — иначе сериализация
            // десятков тысяч строк каждые 400 мс заметна на слабых устройствах
            await Task.Delay(TotalPorts > 20000 ? 1000 : 400);
            try
            {
                var status = await Http.GetFromJsonAsync<ScanStatus>(OnlyOpen
                    ? "api/scan/status"
                    : "api/scan/status?all=1");
                if (status == null) continue;
                ScannedPorts = status.Scanned;
                TotalPorts = status.Total;
                Results = status.Results?.ToList() ?? new List<PortResult>();
                PingInfo = status.Ping;
                // AUTO: показываем в поле таймаута живое значение от регулятора
                if (NetMode == "auto" && status.Timeout > 0)
                    TimeoutMs = status.Timeout;
                if (status.Paused != IsPaused)
                {
                    IsPaused = status.Paused;
                    AddLog(IsPaused ? "Сканирование приостановлено." : "Сканирование продолжено.", "dim");
                }
                // в журнал пишем только смену состояния (отвечает/молчит) — иначе каждые 5 с
                // спам от изменения миллисекунд; полный текст с временем живёт в строке прогресса
                var pingState = string.IsNullOrEmpty(status.Ping)
                    ? null
                    : (status.Ping.StartsWith("Хост отвечает") ? "ok" : "fail");
                if (pingState != null && pingState != _pingLogged)
                {
                    _pingLogged = pingState;
                    AddLog(status.Ping, pingState == "ok" ? "ok" : "dim");
                }
                foreach (var result in Results)
                {
                    // закрытые порты (когда показаны «все») в журнал не пишем —
                    // иначе тысячи записей «закрыт» смывают полезные события
                    if (result.Status == "closed")
                        continue;
                    var key = result.Protocol + ":" + result.Port;
                    if (_knownKeys.Add(key))
                    {
                        var service = KnownServices.TryGetValue(result.Port, out var name) ? $" ({name})" : "";
                        var statusText = result.Status == "open" ? "открыт" : "неопределённо (тишина)";
                        var banner = !string.IsNullOrEmpty(result.Banner) ? $", баннер: «{result.Banner}»" : "";
                        AddLog($"{result.Protocol.ToUpperInvariant()} порт {result.Port} {statusText}{service}{banner}",
                            result.Status == "open" ? "ok" : "warn");
                    }
                }
                if (!string.IsNullOrEmpty(status.Error) && status.Error != ErrorMessage)
                {
                    ErrorMessage = status.Error;
                    AddLog(status.Error, "err");
                }
                if (!status.Running)
                {
                    IsScanning = false;
                    ScanCompleted = true;
                    // последний опрос мог идти без закрытых портов (режим «только открытые») —
                    // догружаем полный результат, чтобы галочка работала и после сканирования
                    try
                    {
                        var final = await Http.GetFromJsonAsync<ScanStatus>("api/scan/status?all=1");
                        if (final?.Results is not null)
                            Results = final.Results.ToList();
                    }
                    catch { }
                    AddLog(_cancelRequested
                        ? "Сканирование отменено."
                        : $"Сканирование завершено. Найдено: {Results.Count(r => r.Status != "closed")}.");
                }
            }
            catch
            {
                // Во время запуска локальный сервер может быть временно занят — повторяем запрос.
            }
            if (_disposed) break;
            try { await InvokeAsync(StateHasChanged); }
            catch (InvalidOperationException) { break; } // рендерер уже уничтожен
        }
    }

    private async Task CancelScan()
    {
        _cancelRequested = true;
        AddLog("Отмена сканирования…", "dim");
        try { await Http.PostAsync("api/scan/cancel", null); } catch { }
    }

    private async Task TogglePause()
    {
        try { await Http.PostAsync("api/scan/pause", null); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_helpReference != null)
        {
            try { await JS.InvokeVoidAsync("portScannerHelp.dispose"); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            _helpReference.Dispose();
        }
    }
