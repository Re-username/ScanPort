@namespace PortScanner.Pages

@page "/"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Сканер портов</PageTitle>

<div class="header">
    <h1>Сканер открытых портов</h1>
    <button type="button" class="btn" @onclick="OpenHelp" title="Открыть справку (F1)">F1 · Справка</button>
    <button type="button" class="btn" @onclick="ToggleIps" title="IP-адреса этого устройства">🖧 IP устройства</button>
    <button type="button" class="btn" @onclick="ToggleTheme" title="Переключить тему">@(IsDark ? "☀ Светлая" : "☾ Тёмная")</button>
    @if (IpsVisible)
    {
        <div class="ips-panel">
            <div class="ips-heading">
                <h4>IP этого устройства</h4>
                <button type="button" class="btn btn-small" @onclick="() => IpsVisible = false" title="Закрыть">✕</button>
            </div>
            @if (LocalIps.Count > 0)
            {
                <ul>
                    @foreach (var ip in LocalIps)
                    {
                        <li><button type="button" class="ip-item" @onclick="() => CopyIp(ip)" title="Скопировать">@ip @if (CopiedIp == ip)
                        {
                            <span class="ip-copied">✓ скопировано</span>
                        }</button></li>
                    }
                </ul>
                <p class="ips-note">Нажмите на адрес, чтобы скопировать. Несколько адресов — несколько сетей (Wi-Fi, Ethernet, VPN); удалённое устройство должно быть в одной из них.</p>
            }
            else
            {
                <p class="ips-note">Не удалось определить IP-адреса устройства.</p>
            }
        </div>
    }
</div>

<div class="form-grid">
    <label>
        IP-адрес или хост
        <input @bind="Host" @bind:after="SaveSettings" placeholder="192.168.1.1" disabled="@IsScanning" />
    </label>
    <label style="grid-column: span 2;">
        Порты (через запятую и тире)
        <input @bind="PortsText" @bind:after="SaveSettings" placeholder="1-1024, 502, 8080" disabled="@IsScanning" />
    </label>
    <label>
        Таймаут, мс
        <input type="number" @bind="TimeoutMs" @bind:after="SaveSettings" min="100" max="30000" disabled="@(IsScanning || NetMode == "auto")" title="@(NetMode == "auto" ? "В режиме AUTO таймаут регулируется автоматически по пингу (показано текущее значение)" : "Время ожидания ответа при проверке каждого порта")" />
    </label>
    <div>
        @if (!IsScanning)
        {
            <button type="button" class="btn primary" @onclick="StartScan">Сканировать</button>
        }
        else
        {
            <button type="button" class="btn" @onclick="TogglePause" disabled="@_cancelRequested">@(IsPaused ? "▶ Продолжить" : "⏸ Пауза")</button>
            <button type="button" class="btn danger" @onclick="CancelScan">Отмена</button>
        }
    </div>
    <div class="checks">
        <label title="TCP: открыт, если удалось установить соединение"><input type="checkbox" @bind="DoTcp" @bind:after="SaveSettings" disabled="@IsScanning" /> TCP</label>
        <label title="UDP: открыт при ответе; без ответа результат неопределён"><input type="checkbox" @bind="DoUdp" @bind:after="SaveSettings" disabled="@IsScanning" /> UDP</label>
        <label title="Баннер — текстовый ответ службы: для TCP приветствие или ответ на HTTP-запрос, для UDP первый ответ на пробу"><input type="checkbox" @bind="DoBanner" @bind:after="SaveSettings" disabled="@IsScanning" /> Баннер</label>
        <label title="Проверка ICMP при старте и далее каждые 5 секунд"><input type="checkbox" @bind="DoPing" @bind:after="SaveSettings" disabled="@IsScanning" /> Ping (ICMP)</label>
        <div class="net-switch" title="LAN — быстро: таймаут 1 с, максимум параллелизма, 1 попытка. WAN — точно: таймаут 5 с, меньше параллелизм, 3 попытки. AUTO — таймаут автоматически подстраивается под пинг (500–10000 мс), пинг адаптируется к сети.">
            <button type="button" class="@(NetMode == "lan" ? "active" : "")" @onclick='() => SetNetMode("lan")' disabled="@IsScanning">LAN</button>
            <button type="button" class="@(NetMode == "auto" ? "active" : "")" @onclick='() => SetNetMode("auto")' disabled="@IsScanning">AUTO</button>
            <button type="button" class="@(NetMode == "wan" ? "active" : "")" @onclick='() => SetNetMode("wan")' disabled="@IsScanning">WAN</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert error" role="alert">@ErrorMessage</div>
}

@if (IsScanning || ScannedPorts > 0 || !string.IsNullOrEmpty(PingInfo))
{
    <div class="progress-wrap">
        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressPercent">
            <div class="progress-bar @(IsScanning ? "animated" : "")" style="width: @ProgressPercent%">
                @ProgressPercent%
            </div>
        </div>
        <div class="progress-note" aria-live="polite">
            Проверено: @ScannedPorts из @TotalPorts
            @if (!string.IsNullOrEmpty(PingInfo))
            {
                <span> · @PingInfo</span>
            }
            @if (IsPaused)
            {
                <span> · пауза</span>
            }
        </div>
    </div>
}

@{
    // материализуем отсортированный/отфильтрованный список один раз на рендер:
    // Virtualize рисует только видимые строки — таблица из десятков тысяч
    // портов прокручивается без подвисаний
    var list = SortedResults.ToList();
}
<div class="results-heading">
    <h3><button type="button" class="collapse-btn" @onclick="() => ResultsVisible = !ResultsVisible">Найдено (@list.Count) <span class="collapse-mark">@(ResultsVisible ? "▾" : "▸")</span></button></h3>
    <label class="open-only" title="Включена — только открытые порты. Выключенная — все проверенные, включая закрытые; переключается в любой момент"><input type="checkbox" checked="@OnlyOpen" @onchange="ToggleOnlyOpen" /> только открытые</label>
    <button type="button" class="btn btn-small" @onclick="CopyResults" disabled="@(Results.Count == 0)" title="Скопировать таблицу (порт, протокол, статус, сервис) в буфер обмена">@(_resultsCopied ? "✓ скопировано" : "Копировать")</button>
    <input class="filter-input" @bind="ResultsFilter" @bind:event="oninput" placeholder="Поиск по результатам…" title="Поиск по порту, протоколу, статусу, названию службы или баннеру" />
</div>
@if (ResultsVisible && Results.Count > 0)
{
    <div class="results-table">
        <table>
            <thead>
                <tr>
                    <th style="width: 90px;" aria-sort="@AriaSort("port")">
                        <button type="button" class="th-sort" @onclick="@(() => SortBy("port"))">Порт <span>@SortMark("port")</span></button>
                    </th>
                    <th style="width: 100px;" aria-sort="@AriaSort("protocol")">
                        <button type="button" class="th-sort" @onclick="@(() => SortBy("protocol"))">Протокол <span>@SortMark("protocol")</span></button>
                    </th>
                    <th style="width: 140px;" aria-sort="@AriaSort("status")">
                        <button type="button" class="th-sort" @onclick="@(() => SortBy("status"))">Статус <span>@SortMark("status")</span></button>
                    </th>
                    <th aria-sort="@AriaSort("banner")">
                        <button type="button" class="th-sort" @onclick="@(() => SortBy("banner"))">Сервис / баннер <span>@SortMark("banner")</span></button>
                    </th>
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="@list" Context="r" OverscanCount="15">
                    <tr>
                        <td class="open-port">@r.Port</td>
                        <td>@r.Protocol.ToUpperInvariant()</td>
                        <td class="st-@r.Status">@StatusText(r.Status)</td>
                        <td class="banner-cell" title="@BannerText(r)">@BannerText(r)</td>
                    </tr>
                </Virtualize>
            </tbody>
        </table>
    </div>
}
@if (ScanCompleted && Results.Count == 0 && string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert info">
        Открытые порты не найдены. Проверьте список портов и таймаут. Отсутствие ответа на ping не означает,
        что TCP-порты закрыты: сканирование соединений выполняется независимо.
    </div>
}

<div class="log-wrap@(LogVisible ? "" : " collapsed")">
    <div class="log-heading">
        <h3><button type="button" class="collapse-btn" @onclick="() => LogVisible = !LogVisible">Журнал <span class="log-count">@LogEntries.Count / @MaxLogEntries</span> <span class="collapse-mark">@(LogVisible ? "▾" : "▸")</span></button></h3>
        <button type="button" class="btn btn-small" @onclick="ClearLog" disabled="@(LogEntries.Count == 0)">Очистить</button>
    </div>
    @if (LogVisible)
    {
    <div class="log" aria-live="polite">
        @if (LogEntries.Count == 0)
        {
            <div class="empty">— событий пока нет —</div>
        }
        else
        {
            @foreach (var e in LogEntries)
            {
                <div><span class="t">@e.Time</span><span class="@e.CssClass">@e.Text</span></div>
            }
        }
    </div>
    }
</div>

@if (HelpVisible)
{
    <div class="help-backdrop" @onclick="CloseHelp">
        <section class="help-dialog" role="dialog" aria-modal="true" aria-labelledby="help-title" @onclick:stopPropagation="true">
            <div class="help-header">
                <h2 id="help-title">Справка по сканеру портов</h2>
                <button type="button" class="btn" @ref="HelpCloseButton" @onclick="CloseHelp" title="Закрыть (Esc)">Закрыть · Esc</button>
            </div>
            <div class="help-body">
                <section>
                    <h3>Быстрый старт</h3>
                    <ol>
                        <li>Введите IP-адрес или имя своего устройства, например <code>192.168.1.1</code>.</li>
                        <li>Укажите диапазон портов, выберите TCP и нажмите «Сканировать».</li>
                        <li>Для определения службы включите «Баннер». «Ping» можно оставить включённым — он не влияет на проверку портов.</li>
                    </ol>
                </section>
                <section>
                    <h3>IP этого устройства</h3>
                    @if (LocalIps.Count > 0)
                    {
                        <p>Адреса этого устройства в сети:</p>
                        <ul>
                            @foreach (var ip in LocalIps)
                            {
                                <li><code>@ip</code></li>
                            }
                        </ul>
                        <p>Адресов может быть несколько, если устройство подключено к нескольким сетям (Wi-Fi, Ethernet, VPN). Удалённое устройство должно быть в одной из этих сетей — сканируйте его адрес из соответствующей подсети.</p>
                    }
                    else
                    {
                        <p>Не удалось определить IP-адреса этого устройства.</p>
                    }
                </section>
                <section>
                    <h3>Порты</h3>
                    <p>Порты задаются одним полем: через запятую, диапазоны — через тире. Дубликаты удаляются, список сортируется.</p>
                    <ul>
                        <li><code>80</code> — один порт;</li>
                        <li><code>1-1024</code> — стандартные системные и сетевые службы;</li>
                        <li><code>80, 443, 8080</code> — несколько разных;</li>
                        <li><code>502, 9600, 44818</code> — типичные порты PLC (Modbus, FINS, EtherNet/IP);</li>
                        <li><code>22, 80-90, 443</code> — комбинация;</li>
                        <li><code>1-65535</code> — полная проверка, может занять много времени.</li>
                    </ul>
                </section>
                <section>
                    <h3>Что такое баннер</h3>
                    <p><strong>Баннер — это текстовый ответ программы, которая работает на открытом порту.</strong> Например: <code>SSH-2.0-OpenSSH_9.6</code>, <code>220 FTP ready</code> или <code>HTTP/1.1 200 OK · Server: nginx</code>.</p>
                    <p>Сканер сначала ждёт приветствие службы. Для типичных веб-портов дополнительно отправляет HTTP-запрос <code>HEAD /</code>. Для UDP баннер — это первый ответ службы на пробную датаграмму. Для промышленных устройств сканер спрашивает идентификацию напрямую: <strong>EtherNet/IP ListIdentity</strong> (порт 44818 — устройство само называет вендора и модель, так Shodan узнаёт «Omron NX1P2»), <strong>Modbus Read Device Identification</strong> (порт 502) и <strong>SNMP sysDescr</strong> (порт 161). Для TLS-служб показывается <strong>сертификат</strong> (имя в CN). Пустой баннер — это нормально: многие службы не сообщают название или используют шифрование. <strong>Отсутствие баннера не означает, что порт закрыт.</strong></p>
                </section>
                <section>
                    <h3>Таймаут и профили сети</h3>
                    <p><strong>Таймаут — это сколько миллисекунд сканер ждёт ответа при проверке каждого порта.</strong> Если служба не ответила за это время, порт считается закрытым или неопределённым.</p>
                    <p>Переключатель рядом с протоколами задаёт профиль:</p>
                    <ul>
                        <li><strong>LAN</strong> — быстро: таймаут 1 с, максимальная параллельность, одна попытка. Для локальной сети;</li>
                        <li><strong>WAN</strong> — точно: таймаут 5 с, меньше параллелизм, до 3 попыток при потере пакета. Для интернета и дальних VPN;</li>
                        <li><strong>AUTO</strong> — саморегулировка: таймаут выставляется от замеренного пинга (×8, в коридоре 500–10000 мс; пинг 100 мс → таймаут 800 мс) и подстраивается каждые 5 с; сам пинг адаптируется к сети (200–2000 мс). Хороший выбор «не думая».</li>
                    </ul>
                    <p>Слишком короткий таймаут может дать ложные «закрыто» на медленных службах; слишком длинный заметно растягивает сканирование больших диапазонов.</p>
                </section>
                <section>
                    <h3>TCP, UDP и ping</h3>
                    <ul>
                        <li><strong>TCP · открыт</strong> — устройство приняло TCP-соединение.</li>
                        <li><strong>UDP · открыт</strong> — на пробную датаграмму получен ответ.</li>
                        <li><strong>UDP · неопределённо</strong> — ответа нет; порт может быть открыт, а ответ заблокирован фильтром.</li>
                        <li><strong>Ping</strong> выполняется сразу и затем каждые 5 секунд. Если устройство запрещает ICMP, TCP/UDP-порты всё равно проверяются.</li>
                    </ul>
                </section>
                <section>
                    <h3>Результаты и журнал</h3>
                    <p>Нажатие на заголовок «Порт», «Протокол», «Статус» или «Сервис / баннер» сортирует таблицу; повторное нажатие меняет направление. Поле «Поиск по результатам» фильтрует таблицу по порту, протоколу, статусу или названию службы и работает вживую во время сканирования. Галочка «только открытые» включена по умолчанию; если снять её, в таблицу попадут все проверенные порты, включая закрытые (переключается в любой момент, в том числе во время сканирования). Кнопка «Копировать» переносит таблицу в буфер обмена. Во время сканирования доступны «⏸ Пауза», «▶ Продолжить» и «Отмена». Журнал хранит до <strong>2000 последних событий</strong> и не очищается при новом сканировании.</p>
                </section>
                <section>
                    <h3>Горячие клавиши</h3>
                    <p><kbd>F1</kbd> — открыть эту справку. <kbd>Esc</kbd> — закрыть справку. Кнопка «Отмена» останавливает текущее сканирование.</p>
                    <p class="help-note">Сканируйте только собственные устройства и сети либо системы, на проверку которых у вас есть разрешение.</p>
                </section>
            </div>
        </section>
    </div>
}

@code {
    private const int MaxLogEntries = 2000;

    private string Host { get; set; } = "127.0.0.1";
    private string PortsText { get; set; } = "1-1024";
    private int TimeoutMs { get; set; } = 1000;
    private bool DoTcp { get; set; } = true;
    private bool DoUdp { get; set; }
    private bool DoBanner { get; set; } = true;
    private bool DoPing { get; set; } = true;
    private string NetMode { get; set; } = "lan"; // lan | auto | wan

    private bool IsScanning;
    private bool ScanCompleted;
    private bool IsPaused;
    private bool IsDark = true;
    private bool HelpVisible;
    private bool IpsVisible;
    private bool ResultsVisible = true;
    private bool LogVisible = true;
    private string? CopiedIp;
    private bool _focusHelp;
    private bool _cancelRequested;
    private bool _disposed;
    private string? ErrorMessage;
    private string? PingInfo;
    private string? _pingLogged;
    private List<PortResult> Results = new();
    private HashSet<string> _knownKeys = new();
    private int ScannedPorts;
    private int TotalPorts;
    private string SortColumn = "port";
    private bool SortAscending = true;
    private string ResultsFilter = "";
    private bool OnlyOpen = true;
    private bool _resultsCopied;
    private List<string> LocalIps = new();
    private readonly List<LogEntry> LogEntries = new();
    private DotNetObjectReference<Home>? _helpReference;
    private ElementReference HelpCloseButton;

    private int ProgressPercent => TotalPorts == 0 ? 0 : Math.Min(100, (int)(100.0 * ScannedPorts / TotalPorts));

    private IEnumerable<PortResult> SortedResults
    {
        get
        {
            var filtered = OnlyOpen
                ? Results.Where(r => r.Status == "open")
                : Results;
            if (!string.IsNullOrWhiteSpace(ResultsFilter))
                filtered = filtered.Where(r => MatchesFilter(r, ResultsFilter));
            Func<PortResult, object> key = SortColumn switch
            {
                "protocol" => r => r.Protocol,
                "status" => r => StatusText(r.Status),
                "banner" => r => BannerText(r),
                _ => r => r.Port
            };
            var sorted = SortAscending
                ? filtered.OrderBy(key).ThenBy(r => r.Port).ThenBy(r => r.Protocol)
                : filtered.OrderByDescending(key).ThenByDescending(r => r.Port).ThenByDescending(r => r.Protocol);
            return sorted;
        }
    }

    private static bool MatchesFilter(PortResult r, string filter)
    {
        var f = filter.Trim();
        return r.Port.ToString().Contains(f, StringComparison.OrdinalIgnoreCase)
            || r.Protocol.Contains(f, StringComparison.OrdinalIgnoreCase)
            || r.Status.Contains(f, StringComparison.OrdinalIgnoreCase)
            || StatusText(r.Status).Contains(f, StringComparison.OrdinalIgnoreCase)
            // BannerText: реальный баннер или название службы из справочника (VNC, SMB, …)
            || BannerText(r).Contains(f, StringComparison.OrdinalIgnoreCase);
    }

    private async Task CopyResults()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Порт\tПротокол\tСтатус\tСервис / баннер");
        foreach (var r in SortedResults)
            sb.AppendLine($"{r.Port}\t{r.Protocol.ToUpperInvariant()}\t{StatusText(r.Status)}\t{BannerText(r)}");
        try
        {
            await JS.InvokeAsync<object>("navigator.clipboard.writeText", sb.ToString());
            _resultsCopied = true;
            await Task.Delay(1200);
            _resultsCopied = false;
        }
        catch { }
    }

    private sealed record LogEntry(string Time, string Text, string CssClass);

    private static readonly Dictionary<int, string> KnownServices = new()
    {
        [20] = "FTP (data)", [21] = "FTP (control)", [22] = "SSH", [23] = "Telnet",
        [25] = "SMTP", [53] = "DNS", [67] = "DHCP (server)", [68] = "DHCP (client)",
        [69] = "TFTP", [80] = "HTTP", [102] = "S7 (Siemens PLC)", [110] = "POP3", [111] = "RPC", [123] = "NTP",
        [135] = "RPC (Windows)", [137] = "NetBIOS name", [138] = "NetBIOS datagram",
        [139] = "NetBIOS session", [143] = "IMAP", [161] = "SNMP", [162] = "SNMP trap",
        [443] = "HTTPS", [445] = "SMB", [500] = "IKE (IPsec)", [502] = "Modbus TCP",
        [514] = "Syslog", [520] = "RIP", [554] = "RTSP (видеокамера)", [993] = "IMAPS", [995] = "POP3S", [1194] = "OpenVPN",
        [1433] = "MS SQL Server", [1434] = "MS SQL Browser (UDP)", [1521] = "Oracle DB",
        [1701] = "L2TP", [1723] = "PPTP", [1812] = "RADIUS", [1880] = "Node-RED", [1883] = "MQTT", [1900] = "UPnP (SSDP)",
        [1911] = "Tridium Niagara (Fox)", [1962] = "PCWorx (Phoenix Contact)", [2000] = "SCCP (Cisco VoIP)",
        [20547] = "ProConOS", [2222] = "EtherNet/IP I/O", [2404] = "IEC 60870-5-104", [3000] = "HTTP (Grafana/dev)",
        [3306] = "MySQL", [3389] = "RDP", [3671] = "KNXnet/IP", [4500] = "IPsec NAT-T", [4840] = "OPC UA",
        [5001] = "Mitsubishi MC", [5060] = "SIP (VoIP)", [5061] = "SIP-TLS", [5353] = "mDNS",
        [5432] = "PostgreSQL", [5900] = "VNC", [5985] = "WinRM (HTTP)", [6379] = "Redis",
        [8000] = "HTTP (alt)",
        [8080] = "HTTP (alt)", [8123] = "Home Assistant", [8883] = "MQTT-TLS",
        [9600] = "Omron FINS", [11740] = "CODESYS V3 TCP",
        [20000] = "DNP3", [2375] = "Docker API", [2376] = "Docker API (TLS)", [27017] = "MongoDB",
        [34962] = "PROFINET", [44818] = "EtherNet/IP", [47808] = "BACnet/IP", [51820] = "WireGuard",
        [53478] = "CODESYS V3 (UDP)", [6443] = "Kubernetes API"
    };

    private sealed record ScanStartResponse(string? Error);
    private sealed record ScanStatus(int Scanned, int Total, PortResult[]? Results, bool Running, string? Error, string? Ping, bool Paused, int Timeout);
    private sealed record PortResult(int Port, string Protocol, string Status, string? Banner);
    private sealed record LocalAddressesResponse(List<string>? Addresses);

    private static string StatusText(string status) => status switch
    {
        "open" => "открыт",
        "closed" => "закрыт",
        _ => "неопределённо",
    };

    private static string BannerText(PortResult r)
    {
        if (!string.IsNullOrWhiteSpace(r.Banner)) return r.Banner;
        return KnownServices.TryGetValue(r.Port, out var service) ? service : "—";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IsDark = await JS.InvokeAsync<string>("getTheme") != "light";
                _helpReference = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("portScannerHelp.init", _helpReference);
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException) { }
            try
            {
                var ips = await Http.GetFromJsonAsync<LocalAddressesResponse>("api/scan/addresses");
                LocalIps = ips?.Addresses ?? new List<string>();
            }
            catch { /* API может быть ещё не поднят — подсказка не критична */ }
            await LoadSettings();
            StateHasChanged();
        }

        if (_focusHelp && HelpVisible)
        {
            _focusHelp = false;
            try { await HelpCloseButton.FocusAsync(); } catch (JSException) { }
        }
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await JS.InvokeVoidAsync("setTheme", IsDark ? "dark" : "light");
    }

    private void ToggleIps() => IpsVisible = !IpsVisible;

